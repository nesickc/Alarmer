{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nesickc/alarmer/blob/main/contracts/golden/golden.schema.json",
  "title": "Golden level vectors and their fixtures",
  "description": "Shapes of the files in contracts/golden/. See README.md there for what they mean.",
  "$defs": {
    "vectorFile": {
      "type": "object",
      "required": ["description", "vectors"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "vectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/vector"}}
      }
    },
    "vector": {
      "type": "object",
      "required": ["id", "rules", "description", "user", "record", "expect"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/rule"}},
        "description": {"type": "string", "minLength": 1},
        "user": {"type": "string", "description": "A user id from world.json"},
        "record": {"type": "object", "description": "Validated separately against record.schema.json#/$defs/record"},
        "expect": {
          "type": "object",
          "required": ["level"],
          "additionalProperties": false,
          "properties": {"level": {"enum": ["L0", "L1", "L2", "L3", "L4", "all_clear"]}}
        }
      }
    },
    "rule": {
      "description": "The spec §6 rule a vector exercises; README.md maps each one to its spec row",
      "enum": [
        "eta.l4", "eta.l3", "eta.l2", "eta.over", "eta.over_ladder", "eta.oblast", "eta.none",
        "approach.cone", "approach.spread", "approach.dest",
        "speed.slow_uav", "speed.jet_uav", "speed.cruise", "speed.banderol", "speed.kh22", "speed.ballistic",
        "speed.record",
        "ballistic.threat", "ballistic.fallback", "ballistic.mig31k", "ballistic.launch", "ballistic.target",
        "ballistic.corridor", "ballistic.in_range", "ballistic.out_of_range", "ballistic.no_threat",
        "ballistic.any_type",
        "area.local", "area.hromada", "area.raion", "area.neighbour", "area.oblast", "area.none",
        "area.other_type",
        "official.alert", "explosion.local", "explosion.city", "explosion.none", "all_clear",
        "status.inactive"
      ]
    },
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,40}$"},
    "latLon": {
      "type": "object",
      "required": ["lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "position": {
      "description": "GeoJSON position: [lon, lat]",
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": -180, "maximum": 180},
        {"type": "number", "minimum": -90, "maximum": 90}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "point": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {"type": {"const": "Point"}, "coordinates": {"$ref": "#/$defs/position"}}
    },
    "polygon": {
      "description": "GeoJSON Polygon with a single closed ring and no holes",
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "Polygon"},
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/position"}}
        }
      }
    },
    "world": {
      "type": "object",
      "required": ["description", "areas", "launch_areas", "users"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "areas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "level", "parent"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "name": {"type": "string"},
              "level": {"enum": ["oblast", "raion", "hromada", "district", "neighbourhood"]},
              "parent": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
              "neighbours": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
              "geometry": {"$ref": "#/$defs/polygon"}
            }
          }
        },
        "launch_areas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "geometry"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "name": {"type": "string"},
              "geometry": {"oneOf": [{"$ref": "#/$defs/point"}, {"$ref": "#/$defs/polygon"}]},
              "origin": {"$ref": "#/$defs/latLon", "description": "Where a vector corridor starts; without it, no corridor"}
            }
          }
        },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "lat", "lon", "areas"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
              "name": {"type": "string"},
              "lat": {"type": "number", "minimum": -90, "maximum": 90},
              "lon": {"type": "number", "minimum": -180, "maximum": 180},
              "areas": {
                "description": "Every area whose polygon contains the user; checked by tests",
                "type": "array",
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/id"}
              }
            }
          }
        }
      }
    },
    "params": {
      "type": "object",
      "required": ["description", "speed_kmh", "eta", "ballistic"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "speed_kmh": {
          "type": "object",
          "required": ["*"],
          "propertyNames": {"pattern": "^(\\*|[a-z0-9_]+\\.\\*|[a-z0-9_]+(\\.[a-z0-9_]+)?)$"},
          "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
        },
        "eta": {
          "type": "object",
          "required": ["bands_min", "cone_min_half_angle_deg", "dest_margin_km"],
          "additionalProperties": false,
          "properties": {
            "bands_min": {
              "type": "object",
              "required": ["L4", "L3", "L2"],
              "additionalProperties": false,
              "properties": {
                "L4": {"type": "number", "minimum": 0},
                "L3": {"type": "number", "minimum": 0},
                "L2": {"type": "number", "minimum": 0}
              }
            },
            "cone_min_half_angle_deg": {"type": "number", "minimum": 0, "maximum": 90},
            "dest_margin_km": {"type": "number", "minimum": 0}
          }
        },
        "ballistic": {
          "type": "object",
          "required": [
            "nationwide_threat_types", "range_km", "fallback_launch_area", "target_radius_km",
            "corridor_half_angle_deg", "corridor_beyond_target_km"
          ],
          "additionalProperties": false,
          "properties": {
            "nationwide_threat_types": {"type": "array", "items": {"type": "string"}},
            "range_km": {"type": "number", "exclusiveMinimum": 0},
            "fallback_launch_area": {"$ref": "#/$defs/id"},
            "target_radius_km": {"type": "number", "minimum": 0},
            "corridor_half_angle_deg": {"type": "number", "minimum": 0, "maximum": 90},
            "corridor_beyond_target_km": {"type": "number", "minimum": 0}
          }
        }
      }
    }
  }
}
